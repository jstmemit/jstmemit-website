---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../sections/HeroSection.astro";
import ContentLayout from "../layouts/ContentLayout.astro";
import CustomizeYourExperienceSection from "../sections/CustomizeYourExperienceSection.astro";
import WhatIsJstmemitSection from "../sections/WhatIsJstmemitSection.jsx";
import ItJustDoesntGetOldSection from "../sections/ItJustDoesntGetOldSection.astro";
import InviteLineSection from "../sections/InviteLineSection.astro";
import HowItWorksSection from "../sections/HowItWorksSection.astro";
import VoiceNarrationSection from "../sections/VoiceNarrationSection.astro";
---

<BaseLayout>
	<HeroSection />
	<ContentLayout background="content-gradient-darker">
		<WhatIsJstmemitSection client:load />
	</ContentLayout>
	<ContentLayout>
		<VoiceNarrationSection />
	</ContentLayout>
	<ContentLayout background="content-gradient-darker">
		<HowItWorksSection />
	</ContentLayout>
	<ContentLayout>
		<CustomizeYourExperienceSection />
	</ContentLayout>
	<ContentLayout>
		<ItJustDoesntGetOldSection />
	</ContentLayout>
	<InviteLineSection />
</BaseLayout>