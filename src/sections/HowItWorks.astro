---
import {CaseSensitive, Brain, Image} from '@lucide/astro'
import IconCard from "../components/IconCard.astro";

const steps = [
    {
        icon: CaseSensitive,
        title: "Step 1",
        description: "Bot chooses a template based on like/dislike metrics, picks 10-15 messages and an image (or a GIF)."
    },
    {
        icon: Brain,
        title: "Step 2",
        description: "Chosen meme engine \"transforms\" given messages into meme text so that they fit the template."
    },
    {
        icon: Image,
        title: "Step 3",
        description: "Text and an image get applied onto a meme template, which then sent to the user who requested it."
    }
]
---

<section class="flex flex-col items-center gap-8">
    <div class="w-full gap-4 flex flex-col items-center text-center">
        <h2 class="text-white text-3xl md:text-5xl font-bold uppercase">how does it work?</h2>
        <p class="text-gray-paragraph text-md md:text-lg tracking-wide">
            This is how our meme generation process works, simplified:
        </p>
    </div>
    <div class="flex flex-col md:flex-row w-full gap-8">
        {steps.map((step) => (
            <IconCard
                icon={step.icon}
                title={step.title}
                description={step.description}
            />
        ))}
    </div>
</section>