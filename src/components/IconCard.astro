---
const { icon: Icon, title, description } = Astro.props;
---

<section class="min-h-[10rem] w-full bg-black/20 rounded-2xl p-6 px-12 flex flex-col items-center justify-center gap-4">
    <Icon class="w-12 h-12 text-magenta-500" />
    <h3 class="text-2xl font-bold uppercase">{title}</h3>
    <p class="text-gray-paragraph text-center">{description}</p>
</section>